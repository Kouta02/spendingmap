# SpendingMap — variáveis do stack Docker. Copie para .env e preencha os valores reais.
#   cp .env.example .env

# --- Banco (lido pela imagem postgres E pelo Django) ---
POSTGRES_DB=spendingmap_db
POSTGRES_USER=spendingmap_user
POSTGRES_PASSWORD=SuaSenhaForteDoBanco
DB_NAME=spendingmap_db
DB_USER=spendingmap_user
DB_PASSWORD=SuaSenhaForteDoBanco

# --- Django (config.settings.production) ---
SECRET_KEY=GerarUmaSecretKeyNova
ALLOWED_HOSTS=spendingmap.com.br,www.spendingmap.com.br,lenovo-arch.tail5e48ac.ts.net,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://spendingmap.com.br,http://lenovo-arch.tail5e48ac.ts.net:8085
CSRF_TRUSTED_ORIGINS=https://spendingmap.com.br,https://www.spendingmap.com.br
# TLS termina na Cloudflare; dentro do túnel é HTTP. Sem isto vira loop de redirect.
SECURE_SSL_REDIRECT=False

# --- Telegram (alertas de boleto) ---
TELEGRAM_BOT_TOKEN=CopiarDoBackendEnv
TELEGRAM_CHAT_ID=CopiarDoBackendEnv

# --- Cloudflare Tunnel ---
# Token do conector, gerado ao criar o túnel (cfd_tunnel/<id>/token).
CLOUDFLARE_TUNNEL_TOKEN=TokenDoConectorDoTunel
